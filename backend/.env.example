# Copy this file to .env and put your real key there
GROQ_API_KEY=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# MAX_STEPS=25
# PORT=8765
# HOST=0.0.0.0   # let other PCs on your network connect (default 127.0.0.1 = this PC only)
# ROUTER=1   # 1 = a cheap model answers chat/general questions itself and only sends browser tasks to the agent; 0 = off
# ROUTER_MODEL=groq:openai/gpt-oss-20b   # which cheap model (default: first of gpt-oss-20b / gemini-flash-lite with a key)
# STRUCTURED_VIEW=1   # 1 = page as sections/items/elements (default), 0 = old flat element list

# More free AI providers (optional, leave empty to skip)
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
